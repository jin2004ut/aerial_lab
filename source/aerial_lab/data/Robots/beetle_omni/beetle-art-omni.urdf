  <!-- ============ End‑Effector (EE) =============== -->
  <!-- Fixed the flange that all tools attach to -->
  <link name="ee_mount"/>
  <joint name="body_to_ee_mount" type="fixed">
    <parent link="main_body"/>
    <child link="ee_mount"/>
    <origin rpy="0 0 0" xyz="0 0 0.1725"/>
  </joint>
  <!-- Tool‑agnostic contact frame (pose set inside each branch) -->
  <link name="ee_contact"/>
  <!-- Tool geometry -->
  <link name="fork">
    <inertial>
      <origin rpy="0 0 0" xyz="0.00000000 0.06681059 -0.00005783"/>
      <mass value="0.140"/>
      <inertia ixx="0.00040632" ixy="0.00000000" ixz="0.00000000" iyy="0.00053824" iyz="0.00000000" izz="0.00040617"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://beetle_omni/mesh/end_effector_fork.dae" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>
  <!-- Mount fork to the flange -->
  <joint name="ee_mount_to_fork" type="fixed">
    <parent link="ee_mount"/>
    <child link="fork"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- Contact point for the fork tips -->
  <joint name="fork_to_ee_contact" type="fixed">
    <parent link="fork"/>
    <child link="ee_contact"/>
    <origin rpy="0 0 0" xyz="0 0 0.104"/>
  </joint>
